cabal-version:      3.14
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'phasedb-hs' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               phasedb-hs

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.3.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Astra Lopez

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         astra.lopez.zagal@gmail.com

-- A copyright notice.
-- copyright:
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    -- Import common warning flags.
    import:           warnings

    -- -fno-omit-yields ensures the RTS can preempt long-running Phase
    -- computations at allocation-free loops, required by §7 / §8 of the
    -- HTTP spec (System.Timeout must be able to interrupt any loop).
    ghc-options:      -fno-omit-yields

    -- Modules exported by the library.
    exposed-modules:  Phase.AST
                    , Phase.Value
                    , Phase.Parser
                    , Phase.Stmt
                    , Phase.Lines
                    , Phase.Tree
                    , Phase.State
                    , Phase.Auth
                    , Phase.Eval
                    , Phase.Catalog
                    , Phase.Exec
                    , Phase.Storage.Types
                    , Phase.Storage.Sync
                    , Phase.Storage.WAL
                    , Phase.Storage.Lock
                    , Phase.Storage.Transaction
                    , Phase.Storage.Engine
                    , Phase.Storage
                    , Phase.Json

    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base ^>=4.20.2.0
                    , text
                    , parsec
                    , scientific
                    , containers
                    , time
                    , directory
                    , filepath
                    , bytestring
                    , cryptonite
                    , memory
                    , binary
                    , aeson

    -- fsync lives in a different package per platform; see
    -- Phase.Storage.Sync. Both ship with GHC.
    if os(windows)
        build-depends: Win32
    else
        build-depends: unix

    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: GHC2024

-- The interactive REPL (renamed from phasedb-hs per §12/D10 of the
-- HTTP API spec).
executable phasedb
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends: base ^>=4.20.2.0
                 , phasedb-hs
                 , text
                 , time
                 , directory
                 , bytestring
                 , haskeline

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: GHC2024

-- HTTP server executable.  Built with -threaded and +RTS -N for
-- parallel request handling per §8 of the HTTP spec.
executable phasedb-server
    -- Import common warning flags.
    import:           warnings

    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

    -- .hs or .lhs file containing the Main module.
    main-is:          Server.hs

    -- Internal server modules (not exported to the library).
    other-modules:    Server.Config
                    , Server.State
                    , Server.Session
                    , Server.Auth
                    , Server.Execute
                    , Server.Json
                    , Server.Routes
                    , Paths_phasedb_hs

    autogen-modules:  Paths_phasedb_hs

    -- Other library packages from which modules are imported.
    build-depends: base ^>=4.20.2.0
                 , phasedb-hs
                 , text
                 , time
                 , directory
                 , bytestring
                 , containers
                 , stm
                 , wai
                 , warp
                 , http-types
                 , aeson
                 , optparse-applicative
                 , cryptonite
                 , memory
                 , network
                 , base64-bytestring
                 , clock
                 , case-insensitive
                 , scientific
                 , warp-tls
                 , parsec

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: GHC2024

test-suite phasedb-hs-test
    -- Import common warning flags.
    import:           warnings

    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

    -- Base language which the package is written in.
    default-language: GHC2024

    -- Server modules needed by the HTTP API test group.
    other-modules:    Server.Config
                    , Server.State
                    , Server.Session
                    , Server.Auth
                    , Server.Execute
                    , Server.Json
                    , Server.Routes
                    , Paths_phasedb_hs

    autogen-modules:  Paths_phasedb_hs

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files (test + app for server modules).
    hs-source-dirs:   test
                    , app

    -- The entrypoint to the test suite.
    main-is:          Main.hs

    -- Test dependencies.
    build-depends:
        base ^>=4.20.2.0,
        phasedb-hs,
        text,
        parsec,
        scientific,
        containers,
        time,
        directory,
        filepath,
        bytestring,
        cryptonite,
        memory,
        stm,
        wai,
        warp,
        http-types,
        aeson,
        wai-extra,
        http-client,
        network,
        base64-bytestring,
        clock,
        case-insensitive,
        optparse-applicative,
        warp-tls
